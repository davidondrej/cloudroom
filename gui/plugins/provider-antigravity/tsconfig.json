{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@get-bb/plugin-sdk": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk.d.ts"
      ],
      "@get-bb/plugin-sdk/provider-bridge/acp": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-provider-bridge-acp.d.ts"
      ],
      "@get-bb/plugin-sdk/app": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"
      ]
    },
    "types": ["node"],
    "jsx": "react-jsx",
    "esModuleInterop": true
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "app.tsx",
    "app.test.tsx",
    "src",
    "vitest.config.ts"
  ]
}
