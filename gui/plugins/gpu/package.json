{
  "name": "bb-plugin-gpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Built-in GPUs: agents rent a GPU box for heavy GPU work, after the user approves its Cloud Credits.",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.48"
  },
  "bb": {
    "name": "GPUs",
    "description": "Agents can rent a GPU for heavy GPU work. Cloudroom asks you first and shows the Cloud Credits it will use.",
    "branding": {
      "icon": "Zap"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@cloudroom/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudroom/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
