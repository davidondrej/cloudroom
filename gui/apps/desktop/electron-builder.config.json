{
  "appId": "dev.cloudroom.gui",
  "productName": "Cloudroom",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "toolsets": {
    "appimage": "1.0.3"
  },
  "afterPack": "scripts/prepare-native-modules.cjs",
  "asar": true,
  "asarUnpack": ["dist/bb-app-bridge.mjs", "node_modules/**", "!node_modules/npm/**", "!node_modules/bb-app/node_modules/npm/**", "!node_modules/bb-app/app/dist/**"],
  "directories": {
    "buildResources": "assets",
    "output": "release.noindex"
  },
  "files": [
    "assets/**",
    "dist/**",
    "node_modules/**",
    "package.json",
    "!**/*.map",
    "!node_modules/date-fns/fp{,/**/*}",
    "!node_modules/date-fns/locale/!(_lib|en-US|en-US.cjs){,/**/*}",
    "!node_modules/date-fns/**/*.{js,d.ts,d.cts}",
    "!node_modules/bb-app/app/dist/**/*.gz",
    "!node_modules/bb-app/server/dist/drizzle/meta/*_snapshot.json",
    "!node_modules/npm/{docs,man}{,/**/*}",
    {
      "from": "node_modules/bb-app/server/dist/app-scaffold-template",
      "to": "node_modules/bb-app/server/dist/app-scaffold-template",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/bb-app/node_modules/npm/node_modules",
      "to": "node_modules/npm/node_modules",
      "filter": ["**/*"]
    }
  ],
  "extraResources": [
    { "from": "../../LICENSE", "to": "LICENSE.cloudroom.txt" },
    { "from": "../../NOTICE", "to": "NOTICE.bb.txt" }
  ],
  "publish": null,
  "protocols": [{ "name": "Cloudroom", "schemes": ["cloudroom"] }],
  "mac": {
    "category": "public.app-category.developer-tools",
    "minimumSystemVersion": "13.0.0",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "icon": "assets/icon.icns",
    "identity": null,
    "notarize": false,
    "extendInfo": {
      "CFBundleAlternateNames": ["Room"],
      "NSDesktopFolderUsageDescription": "Cloudroom agents read and write files you ask them to work on.",
      "NSDocumentsFolderUsageDescription": "Cloudroom agents read and write files you ask them to work on.",
      "NSDownloadsFolderUsageDescription": "Cloudroom agents read and write files you ask them to work on."
    },
    "extraResources": [
      {
        "from": ".bundled-runtimes/python",
        "to": "app.asar.unpacked/node_modules/bb-app/server/dist/assets/python",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      { "from": ".bundled-runtimes/cloudroom-core", "to": "app.asar.unpacked/node_modules/bb-app/server/dist/assets/cloudroom-core" },
      { "from": ".bundled-runtimes/git", "to": "git" }
    ],
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ]
  },
  "linux": {
    "category": "Development",
    "executableName": "gui-cloudroom",
    "icon": "assets/icon.png",
    "syncDesktopName": true,
    "target": [{ "target": "AppImage", "arch": ["x64"] }]
  },
  "win": {
    "icon": "assets/icon.png",
    "electronLanguages": ["en-US"],
    "extraResources": [
      {
        "from": ".bundled-runtimes/python",
        "to": "app.asar.unpacked/node_modules/bb-app/server/dist/assets/python",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc", "!{include,tcl}/**"]
      }
    ],
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "include": "build/installer.nsh"
  },
  "dmg": {
    "sign": false,
    "title": "Cloudroom",
    "iconSize": 120,
    "contents": [
      { "x": 180, "y": 190, "type": "file" },
      { "x": 480, "y": 190, "type": "link", "path": "/Applications" }
    ]
  },
  "npmRebuild": false
}
