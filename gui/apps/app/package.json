{
  "name": "@cloudroom/app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "generate:pwa-icons:check": "node scripts/generate-pwa-icons.mjs --check",
    "dev": "node scripts/generate-pwa-icons.mjs && vite --config vite.dev.config.ts --configLoader runner",
    "build": "node scripts/generate-pwa-icons.mjs && vite build --logLevel warn && node ../../scripts/precompress-app-dist.mjs dist",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "clean": "rimraf dist bundle-stats.json",
    "storybook": "vite --config .ladle/vite.config.ts",
    "storybook:build": "vite build --config .ladle/vite.config.ts",
    "lint": "oxlint src vite.config.ts vite.dev.config.ts vite-app-files.ts vite-bundle-stats.ts vite-font-preload.ts vite-shared-ui-seam.ts vite-react-compiler.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/generate-pwa-icons.mjs --check && vitest run --config vitest.config.ts"
  },
