{
  "name": "bb-app",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Cloudroom launcher: runs the server and host daemon",
  "type": "module",
  "exports": {
    "./dist/bb-app.js": "./dist/bb-app.js"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "bb-app": "dist/bb-app.js",
    "room-cli": "dist/room-cli.js"
  },
  "files": [
    "app/dist",
    "dist",
    "!dist/*.map",
    "host-daemon/dist/room-cli",
    "host-daemon/dist/room-cli.cmd",
    "host-daemon/dist/room-cli.ps1",
    "host-daemon/dist/room-cli-chunks",
    "host-daemon/dist/bb-parcel-watcher-child.mjs",
    "host-daemon/dist/bb-plugin-host-worker.mjs",
    "host-daemon/dist/bb-provider-bridge-worker.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "!server/dist/index.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-cli-chunks.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "13.0.3",
    "fs-native-extensions": "1.5.0",
    "hono": "^4.7.0",
    "jiti": "^2.6.1",
    "node-pty": "1.2.0-beta.15",
    "npm": "11.16.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudroom/config": "workspace:*",
    "@cloudroom/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
