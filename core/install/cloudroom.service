[Unit]
Description=Cloudroom core
After=network-online.target
Wants=network-online.target

[Service]
User=cloudroom
Group=cloudroom
ExecStartPre=+/usr/bin/install -d -m 0700 -o cloudroom-agent -g cloudroom-agent /var/cache/cloudroom-agent
ExecStart=/usr/local/lib/cloudroom/cloudroom
EnvironmentFile=/etc/cloudroom/core.env
Environment=CLOUDROOM_STORAGE_POLICY=/etc/cloudroom/storage.json
Delegate=yes
RuntimeDirectory=cloudroom
RuntimeDirectoryMode=0711
# The trusted core attaches children to cgroups, then drops all their capabilities.
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_KILL
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_KILL
NoNewPrivileges=yes
UMask=0077
# The inherited 1024 soft limit was exhausted by HTTP/SSE gateway connections.
LimitNOFILE=524288
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
