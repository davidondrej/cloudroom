{
  "name": "@cloudroom/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Cloudroom core HTTP API.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/davidondrej/cloudroom/blob/main/core/docs/api.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidondrej/cloudroom.git",
    "directory": "core/integrations/bb"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc client.ts --outDir dist --declaration --target es2022 --module es2022 --lib es2022,dom --strict --skipLibCheck",
    "prepack": "npm run build"
  }
}
